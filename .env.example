# Fonte de verdade real é o Infisical — este arquivo só documenta quais
# variáveis existem. Ver design em docs-warehouse/architecture.

# api-core (leituras de catálogo em /internal/catalog/**, autenticadas por X-Service-Key)
PERSISTENCE_BASE_URL=http://localhost:8080
SERVICE_KEY_CORE=troque-pela-chave-de-servico-do-mcp-database

# /mcp (chave própria deste serviço, não é credencial de tecnologia compartilhada)
MCP_API_KEY=troque-por-uma-chave-forte-de-verdade

# api-recommendation (feeds ranqueados que o MCP expõe ao agente)
RECOMMENDATION_API_URL=http://localhost:8000
RECOMMENDATION_API_KEY=troque-pela-chave-da-api-recommendation

PORT=8001
