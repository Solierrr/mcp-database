# Fonte de verdade real é o Infisical — este arquivo só documenta quais
# variáveis existem. Ver design em docs-warehouse/architecture.

# /database (Postgres "Negócio" — mesma instância/credenciais do api-core, banco próprio)
DB_POSTGRES_HOST=localhost
DB_POSTGRES_PORT=5432
DB_POSTGRES_USER=usuario
DB_POSTGRES_PASSWORD=senha
DB_POSTGRES_BUSINESS=negocio

# /service-keys (X-Service-Key, mínimo de 32 caracteres)
# Chaves dos agentes aceitos no /mcp
SERVICE_KEY_AI_ASSISTANT=
SERVICE_KEY_AI_OPERATIONAL=
# Chave própria, enviada à api-recommendation (mesmo valor de SERVICE_KEY_MCP_DATABASE)
SERVICE_KEY=

# /mcp (chave antiga x-api-key, aceita só até os agentes enviarem X-Service-Key)
MCP_API_KEY=

# api-recommendation (feeds ranqueados que o MCP expõe ao agente)
RECOMMENDATION_API_URL=http://localhost:8000
# Chave antiga X-Recommendation-Key, enviada só até a api-recommendation aceitar X-Service-Key
RECOMMENDATION_API_KEY=

PORT=8001
